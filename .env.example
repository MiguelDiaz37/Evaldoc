DATABASE_URL=sqlite:///./evaldoc.db
# Clave para firmar los JWT, minimo 32 caracteres. Generar una con:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_MINUTOS=30
BCRYPT_RONDAS=12
# Seguridad (ver docs/owasp-api-top10-2023.md)
DOCS_ACTIVOS=true
CORS_ORIGENES=
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_S=60
